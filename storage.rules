rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Imagens de produtos, logos e rótulos
    match /tenants/{tenantId}/{allPaths=**} {
      // Leitura pública das fotos dos cosméticos para a página do consumidor
      allow read: if true;
      // Upload permitido apenas para operadores autenticados
      allow write: if request.auth != null;
    }
  }
}
